{% comment %}
  Product Card Custom
  
  A responsive product card for use in collection loops and featured product grids.
  Features:
  - Featured and hover images from metafields
  - Smooth hover effect
  - Bestseller badge based on product tags
  - Responsive design with semantic HTML
  - Lazy loading for images
{% endcomment %}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-image-container">
      {% if product.metafields.custom.featured_image %}
        {% assign featured_image = product.metafields.custom.featured_image %}
        <img 
          src="{{ featured_image | image_url: width: 600 }}"
          alt="{{ product.title | escape }}"
          width="600"
          height="{{ 600 | divided_by: featured_image.aspect_ratio | round }}"
          loading="lazy"
          class="product-image"
        >
      {% else %}
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.title | escape }}"
            width="600"
            height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
            loading="lazy"
            class="product-image"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-image' }}
        {% endif %}
      {% endif %}

      {% if product.metafields.custom.hover_image %}
        {% assign hover_image = product.metafields.custom.hover_image %}
        <img 
          src="{{ hover_image | image_url: width: 600 }}"
          alt="{{ product.title | escape }}"
          width="600"
          height="{{ 600 | divided_by: hover_image.aspect_ratio | round }}"
          loading="lazy"
          class="hover-image"
        >
      {% elsif product.images[1] %}
        <img 
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.title | escape }}"
          width="600"
          height="{{ 600 | divided_by: product.images[1].aspect_ratio | round }}"
          loading="lazy"
          class="hover-image"
        >
      {% endif %}

      {% if product.tags contains 'bestseller' %}
        <div class="product-badge">Bestseller</div>
      {% endif %}
    </div>

    <div class="product-info">
      <h3 class="product-title">{{ product.title }}</h3>
      
      <div class="product-price">
        {% if product.compare_at_price > product.price %}
          <span class="price-sale">{{ product.price | money }}</span>
          <span class="price-compare">{{ product.compare_at_price | money }}</span>
        {% else %}
          <span class="price-regular">{{ product.price | money }}</span>
        {% endif %}
      </div>
    </div>
  </a>
</article>

<style>
  .product-card {
    position: relative;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .product-image-container {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #f5f5f5;
  }

  .product-image,
  .hover-image,
  .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease-in-out;
  }

  .product-image {
    opacity: 1;
    z-index: 1;
  }

  .hover-image {
    opacity: 0;
    z-index: 2;
  }

  .product-card:hover .product-image {
    opacity: 0;
  }

  .product-card:hover .hover-image {
    opacity: 1;
  }

  .product-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    background-color: #AF5A3C;
    color: white;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    flex-grow: 1;
  }

  .product-title {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .product-price {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
  }

  .price-sale {
    color: #AF5A3C;
    font-weight: 600;
  }

  .price-compare {
    text-decoration: line-through;
    color: #777;
  }

  .price-regular {
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .product-title {
      font-size: 1.125rem;
    }

    .product-price {
      font-size: 1rem;
    }

    .product-badge {
      font-size: 0.8125rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>

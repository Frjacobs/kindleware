{% comment %}
  Announcement Marquee Section
  
  A horizontally scrolling announcement ticker for promotional messages.
  Features smooth CSS animation and customizable text via section settings.
{% endcomment %}

<section class="marquee-section">
  <div class="marquee">
    <div class="marquee-track">
      {% if section.blocks.size > 0 %}
        {% for i in (1..3) %}
          {% for block in section.blocks %}
            <span class="marquee-item" {{ block.shopify_attributes }}>
              {% if block.settings.announcement_text != blank %}
                {{ block.settings.announcement_text }}
              {% else %}
                Announcement Text
              {% endif %}
            </span>
            <span class="marquee-divider">•</span>
          {% endfor %}
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <span class="marquee-item">Free Shipping Over $85</span>
          <span class="marquee-divider">•</span>
          <span class="marquee-item">100-Day Trial</span>
          <span class="marquee-divider">•</span>
          <span class="marquee-item">Free Returns</span>
          <span class="marquee-divider">•</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .marquee-section {
    overflow: hidden;
    width: 100%;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_y }}px 0;
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: inline-flex;
    white-space: nowrap;
    animation: marquee {{ section.settings.animation_duration }}s linear infinite;
    animation-direction: {{ section.settings.scroll_direction }};
  }

  .marquee-item {
    display: inline-block;
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.font_weight }};
    padding: 0 20px;
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  .marquee-divider {
    display: inline-block;
    font-size: {{ section.settings.text_size }}px;
    opacity: 0.5;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @media screen and (max-width: 749px) {
    .marquee-item {
      font-size: {{ section.settings.mobile_text_size }}px;
      padding: 0 15px;
    }
    
    .marquee-divider {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "normal",
          "label": "Left to Right"
        },
        {
          "value": "reverse",
          "label": "Right to Left"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Animation Duration",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile Text Size",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 0.5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "name": "Announcement",
      "type": "announcement",
      "settings": [
        {
          "type": "text",
          "id": "announcement_text",
          "label": "Announcement Text",
          "default": "Free Shipping Over $85"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Marquee",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "announcement_text": "Free Shipping Over $85"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "announcement_text": "100-Day Trial"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "announcement_text": "Free Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}

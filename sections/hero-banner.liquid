{% comment %}
  Hero Banner Section
  
  A responsive hero section designed for high conversions on both mobile and desktop.
  Features headline, reviews, benefits, and CTA with configurable content through schema.
{% endcomment %}

<section class="hero-banner">
  <div class="hero-container">
    {% if section.settings.hero_image != blank %}
      <div class="hero-image">
        {{ section.settings.hero_image | image_url: width: 1500 | image_tag: 
          loading: 'eager',
          sizes: '(min-width: 750px) 1500px, 100vw',
          alt: section.settings.heading | escape
        }}
      </div>
    {% else %}
      <div class="hero-image" style="background-color: #e0e0e0; width: 100%; height: 300px; display: flex; align-items: center; justify-content: center;">
        <span style="color: #757575;">Placeholder Image</span>
      </div>
    {% endif %}

    <div class="hero-content">
      {% if section.settings.trusted_by_text != blank %}
        <div class="trusted-text">
          <span style="color: {{ section.settings.trusted_icon_color }};">
            ★
          </span>
          {{ section.settings.trusted_by_text }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <p class="hero-subtext">{{ section.settings.subheading }}</p>
      {% endif %}
      
      <ul class="hero-benefits">
        {% assign benefits = section.settings.benefit_bullets | split: '\n' %}
        {% for benefit in benefits %}
          <li>
            <span class="benefit-icon">✓</span>
            <span>{{ benefit }}</span>
          </li>
        {% endfor %}
      </ul>
      
      {% assign cta_text = section.settings.cta_text | default: 'Shop Now' %}
      {% if section.settings.cta_link != blank %}
        <div class="hero-cta-wrapper">
          <a href="{{ section.settings.cta_link }}" class="hero-cta" style="background-color: {{ section.settings.button_bg_color | default: '#AF5A3C' }}; color: {{ section.settings.button_text_color | default: '#ffffff' }};">
            {{ cta_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
    padding: 0;
    width: 100%;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    max-width: 1440px;
    margin: 0 auto;
  }

  .trusted-text {
    font-size: 1rem;
    margin-bottom: 1rem;
    text-align: {{ section.settings.text_alignment }};
  }

  .hero-image {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-content {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: {{ section.settings.text_alignment }};
  }

  .hero-heading {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0;
    font-weight: 700;
  }

  .hero-subtext {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .hero-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-benefits li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .benefit-icon {
    color: #4CAF50;
    font-weight: bold;
  }

  .hero-cta-wrapper {
    margin-top: 1rem;
  }

  .hero-cta {
    display: inline-block;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.2s ease;
    text-align: center;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .hero-container {
      flex-direction: row;
      min-height: 500px;
    }

    .hero-content {
      width: 50%;
      padding: 4rem;
      justify-content: center;
    }

    .hero-image {
      width: 50%;
      height: auto;
    }

    .hero-heading {
      font-size: 2.5rem;
    }

    .hero-subtext {
      font-size: 1.125rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Experience"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover why customers love our products"
    },
    {
      "type": "text",
      "id": "trusted_by_text",
      "label": "Trusted By Text",
      "default": "Trusted by over 4,000 customers"
    },
    {
      "type": "color",
      "id": "trusted_icon_color",
      "label": "Trusted Icon Color",
      "default": "#FFD700"
    },
    {
      "type": "textarea",
      "id": "benefit_bullets",
      "label": "Benefit Bullets",
      "default": "Premium Quality Materials\nSustainable Manufacturing\nFree Shipping Worldwide"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#AF5A3C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Hero Sections"
    }
  ]
}
{% endschema %}
